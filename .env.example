# STP environment template — copy to backend/.env and fill in (backend/.env is
# gitignored; pydantic-settings reads it from the backend working directory).

# --- Database / infrastructure (defaults work locally) ---
# DATABASE_URL=sqlite+aiosqlite:///./stp.db
# EVENT_BUS=memory
# SESSION_STORE=memory

# --- Simulation replay ---
# REPLAY_BARS_PER_SECOND=1.0
# REPLAY_START=2026-08-24
# REPLAY_MODE=loop

# --- GenAI agent (design 27) -------------------------------------------------
# Default is mock: rule-based news summary, keyword-RAG help, rules advisory.
# Set these to switch the agent to a live OpenAI-compatible model — the app
# checks connectivity at startup and falls back to mock when unreachable.
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small
# Only set these if the embedding model lives on a different endpoint/key:
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# LLM_TIMEOUT_SECONDS=15
# RAG_TOP_K=4
